{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "paths": {
      "@pack/parser": ["./packages/parser/src/index.ts"],
      "@pack/db": ["./packages/db/src/index.ts"]
    }
  }
}
