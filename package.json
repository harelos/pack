{
  "name": "pack",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "db:generate": "npm -w @pack/db run generate",
    "db:migrate": "npm -w @pack/db run migrate",
    "eval": "npm -w @pack/parser run eval",
    "prototype": "node prototype/server.mjs",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  }
}
