# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
PARSER_MODEL_PRIMARY=claude-sonnet-5
PARSER_MODEL_CHEAP=claude-haiku-4-5

# --- Supabase / Postgres ---
# Pooled (pgbouncer) connection for the app runtime:
DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection for migrations:
DIRECT_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...        # server-only, never bundled in mobile

# --- Food lookup (Open Food Facts primary, USDA FDC fallback) ---
# Open Food Facts needs NO key. USDA FoodData Central is optional fallback:
USDA_FDC_API_KEY=                              # get free at https://fdc.nal.usda.gov/api-key-signup.html

# --- Cost guardrail ---
PARSER_DAILY_SPEND_KILL_SWITCH_USD=50        # force Haiku globally if daily spend exceeds

# --- Prototype (browser tester) ---
PACK_PROTO_PORT=5178
PACK_PROTO_MODEL=claude-sonnet-5             # or claude-haiku-4-5 for cheaper/faster testing
